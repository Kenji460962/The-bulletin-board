<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>過去ログ・アーカイブ一覧 - talk-ch</title>

    <link rel="icon" href="/static/favicon.webp" type="image/webp">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
    <link rel="manifest" href="/static/site.webmanifest">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

    <script>
        (function() {
            var saved = localStorage.getItem('talk_ch_theme');
            if (saved === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>

    <style>
        :root {
            --bg-base: #0b0f19;
            --bg-surface: #111827;
            --bg-card: #172033;
            --border-subtle: #243046;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-primary: #38bdf8;
            --pill-bg: #1e293b;
        }

        html[data-theme="light"] {
            --bg-base: #f1f5f9;
            --bg-surface: #ffffff;
            --bg-card: #ffffff;
            --border-subtle: #e2e8f0;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #94a3b8;
            --accent-primary: #0284c7;
            --pill-bg: #f1f5f9;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Plus Jakarta Sans', 'Noto Sans JP', sans-serif;
            background: var(--bg-base);
            color: var(--text-primary);
            padding: 20px 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 760px;
        }

        .top-nav {
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 600;
        }

        .top-nav a {
            color: var(--accent-primary);
            text-decoration: none;
        }

        .panel {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 24px;
        }

        h1 {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .sub {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        .archive-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .archive-item {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 10px;
            padding: 14px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: inherit;
            transition: all 0.15s ease;
        }

        .archive-item:hover {
            border-color: var(--accent-primary);
            transform: translateY(-1px);
        }

        .archive-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .archive-meta {
            font-size: 12px;
            color: var(--text-muted);
            background: var(--pill-bg);
            padding: 4px 10px;
            border-radius: 6px;
            white-space: nowrap;
        }

        .empty {
            text-align: center;
            padding: 30px;
            color: var(--text-muted);
            font-size: 14px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="top-nav">
        <a href="/">← talk-ch掲示板に戻る</a>
    </div>

    <div class="panel">
        <h1>📦 過去ログ・スレッドアーカイブ一覧</h1>
        <div class="sub">すべてのスレッドのログを閲覧できます（閲覧専用）</div>

        <% const list = (typeof archives !== 'undefined' && archives) || (typeof archived_threads !== 'undefined' && archived_threads) || []; %>

        <% if (list.length > 0) { %>
        <ul class="archive-list">
            <% list.forEach(function(t) { %>
            <li>
                <a class="archive-item" href="/archive/<%= t.id || t.thread_id %>">
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <% if (t.category_name) { %>
                        <span style="font-size: 11px; background: rgba(56, 189, 248, 0.12); color: var(--accent-primary); padding: 2px 6px; border-radius: 4px; font-weight: 700;">
                            <%= t.category_icon || '💬' %> <%= t.category_name %>
                        </span>
                        <% } %>
                        <span class="archive-title">【#<%= t.id || t.thread_id %>】 <%= t.title %></span>
                    </div>
                    <span class="archive-meta">💬 <%= t.replies_count || t.reply_count || 0 %>レス</span>
                </a>
            </li>
            <% }); %>
        </ul>
        <% } else { %>
        <div class="empty">まだ過去ログはありません</div>
        <% } %>
    </div>
</div>

</body>
</html>
