<!DOCTYPE html>
<html lang="ja">
<head>
    <link rel="icon" href="/static/favicon.webp" type="image/webp">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
    <link rel="manifest" href="/static/site.webmanifest">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>オンラインチェス - talk-ch</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f172a;
            --panel-bg: #1e293b;
            --border-color: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-color: #38bdf8;
            --accent-hover: #0ea5e9;
            --board-light: #f0d9b5;
            --board-dark: #b58863;
            --board-border: #7c5835;
        }

        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        a { color: var(--accent-color); text-decoration: none; }
        a:hover { text-decoration: underline; }

        .top-nav {
            width: 100%;
            max-width: 480px;
            margin-bottom: 12px;
            font-size: 13px;
            line-height: 1.8;
        }

        .panel {
            width: 100%;
            max-width: 480px;
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 16px;
        }

        h1 { font-size: 20px; margin: 0 0 4px 0; }
        h2 { font-size: 16px; margin: 0 0 12px 0; color: var(--text-muted); font-weight: 600; }

        input[type="text"] {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 10px;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
        }
        input[type="text"]:focus { border-color: var(--accent-color); }

        button {
            background: var(--accent-color);
            color: #06202e;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.15s ease;
        }
        button:hover { background: var(--accent-hover); }
        button:disabled { background: #475569; color: var(--text-muted); cursor: not-allowed; }

        .lobby-actions { display: flex; flex-direction: column; gap: 16px; }
        .lobby-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .lobby-row input { flex: 1; min-width: 160px; }

        .players-box {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            font-size: 14px;
            gap: 8px;
            flex-wrap: wrap;
        }
        .turn-indicator { font-weight: 700; }

        .board {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 0;
            border: 3px solid var(--board-border);
            border-radius: 4px;
            aspect-ratio: 1 / 1;
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
            overflow: hidden;
        }

        .cell {
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            user-select: none;
            cursor: pointer;
        }
        .cell.light { background: var(--board-light); }
        .cell.dark { background: var(--board-dark); }
        .cell .piece-glyph {
            width: 78%;
            height: 78%;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
        }
        .cell.selected { outline: 3px solid var(--accent-color); outline-offset: -3px; }
        .cell.hint::after {
            content: '';
            position: absolute;
            width: 26%;
            height: 26%;
            border-radius: 50%;
            background: rgba(56, 189, 248, 0.55);
        }
        .cell.hint-capture { outline: 3px solid rgba(248, 113, 113, 0.8); outline-offset: -3px; }
        .cell.in-check { background: rgba(248, 113, 113, 0.55) !important; }
        .room-code-box {
            background: var(--bg-color);
            border: 1px dashed var(--border-color);
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 14px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }
        .room-code-box strong { font-size: 18px; letter-spacing: 2px; color: var(--accent-color); }
        .msg { font-size: 13px; color: var(--text-muted); margin-top: 8px; min-height: 18px; }
        .msg.error { color: #f87171; }
        .result-banner {
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            padding: 12px;
            margin-bottom: 12px;
            border-radius: 8px;
            background: rgba(56, 189, 248, 0.15);
        }

        .piece-symbol {
            font-size: min(8vw, 36px);
            line-height: 1;
            filter: drop-shadow(0 1px 1px rgba(0,0,0,0.4));
        }
        .piece-symbol.piece-white {
            color: #f8fafc;
            -webkit-text-stroke: 1px #1a1a1a;
        }
        .piece-symbol.piece-black {
            color: #262626;
            -webkit-text-stroke: 1px #0a0a0a;
        }
    </style>
</head>
<body>

    <div class="top-nav">
        <a href="/">← talk-chに戻る</a>
        <span style="color: var(--text-muted); margin: 0 6px;">|</span>
        <a href="/chess">♟️ チェスロビーへ</a>
    </div>

    <% if (!room) { %>
    <div class="panel">
        <h1>オンラインチェス</h1>
        <h2>友達と対戦しよう（登録不要・匿名）</h2>
        <div class="lobby-actions">
            <div>
                <div style="font-size: 13px; color: var(--text-muted); margin-bottom: 6px;">表示する名前（省略可）</div>
                <input type="text" id="player-name-input" placeholder="名無しさん" maxlength="20" style="width: 100%;">
            </div>
            <div>
                <button id="create-room-btn">新しい部屋を作る</button>
            </div>
            <div>
                <div style="font-size: 13px; color: var(--text-muted); margin-bottom: 6px;">部屋コードを持っている場合</div>
                <div class="lobby-row">
                    <input type="text" id="join-code-input" placeholder="例: AB12CD" maxlength="6" style="text-transform: uppercase;">
                    <button id="join-room-btn">参加する</button>
                </div>
            </div>
        </div>
        <div class="msg" id="lobby-msg"></div>
    </div>

    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
            return '';
        }
        const savedAuthor = getCookie('bbs_saved_author');
        if (savedAuthor) {
            document.getElementById('player-name-input').value = savedAuthor;
        }

        function getPlayerName() {
            return document.getElementById('player-name-input').value.trim();
        }

        document.getElementById('create-room-btn').addEventListener('click', async () => {
            const btn = document.getElementById('create-room-btn');
            btn.disabled = true;
            try {
                const formData = new FormData();
                formData.append('name', getPlayerName());
                const res = await fetch('/chess/create', { method: 'POST', body: formData });
                if (res.redirected) {
                    window.location.href = res.url;
                } else {
                    document.getElementById('lobby-msg').textContent = '部屋の作成に失敗しました';
                    document.getElementById('lobby-msg').classList.add('error');
                    btn.disabled = false;
                }
            } catch (e) {
                document.getElementById('lobby-msg').textContent = '通信エラーが発生しました';
                document.getElementById('lobby-msg').classList.add('error');
                btn.disabled = false;
            }
        });

        document.getElementById('join-room-btn').addEventListener('click', async () => {
            const input = document.getElementById('join-code-input');
            const code = input.value.trim().toUpperCase();
            const msgEl = document.getElementById('lobby-msg');
            msgEl.classList.remove('error');
            if (!code) {
                msgEl.textContent = '部屋コードを入力してください';
                msgEl.classList.add('error');
                return;
            }
            try {
                const res = await fetch(`/chess/${code}/join`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: getPlayerName() })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = `/chess/${code}`;
                } else {
                    msgEl.textContent = data.error || '参加に失敗しました';
                    msgEl.classList.add('error');
                }
            } catch (e) {
                msgEl.textContent = '通信エラーが発生しました';
                msgEl.classList.add('error');
            }
        });

        document.getElementById('join-code-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') document.getElementById('join-room-btn').click();
        });
    </script>

    <% } else { %>
    <div class="panel">
        <div class="room-code-box">
            <span>部屋コード: <strong><%= room.room_code %></strong></span>
            <button id="copy-link-btn" style="font-size: 12px; padding: 5px 10px;">リンクをコピー</button>
        </div>

        <div class="players-box" id="players-box"></div>
        <div id="result-banner-area"></div>
        <div class="status-bar">
            <div class="turn-indicator" id="turn-indicator">読み込み中...</div>
        </div>

        <div class="board" id="board"></div>
        <div class="msg" id="game-msg"></div>
    </div>

    <script>
        const roomCode = <%- JSON.stringify(room.room_code) %>;
        let myColor = <%- JSON.stringify(my_color) %>;
        let selected = null;
        let legalTargetsForSelected = [];
        
        const PIECE_SYMBOLS = {
            'K': '♚',
            'Q': '♛',
            'R': '♜',
            'B': '♝',
            'N': '♞',
            'P': '♟'
        };

        function pieceMarkup(pieceType, colorClass) {
            const symbol = PIECE_SYMBOLS[pieceType] || '';
            return `<div class="piece-symbol ${colorClass}">${symbol}</div>`;
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function pieceLabel(color) {
            return color === 'w' ? '白' : '黒';
        }

        const KNIGHT_MOVES = [[-2,-1],[-2,1],[-1,-2],[-1,2],[1,-2],[1,2],[2,-1],[2,1]];
        const ROOK_DIRS = [[-1,0],[1,0],[0,-1],[0,1]];
        const BISHOP_DIRS = [[-1,-1],[-1,1],[1,-1],[1,1]];
        const KING_DIRS = ROOK_DIRS.concat(BISHOP_DIRS);
        function inBounds(r,c) { return r>=0 && r<8 && c>=0 && c<8; }

        function pseudoTargets(board, r, c, statusData) {
            const piece = board[r*8+c];
            if (!piece) return [];
            const color = piece[0], ptype = piece[1];
            const targets = [];
            const enPassant = statusData && statusData.en_passant;
            const castling = (statusData && statusData.castling) || '';
            if (ptype === 'P') {
                const dir = color==='w' ? -1 : 1;
                const startRow = color==='w' ? 6 : 1;
                const oneR = r+dir;
                if (inBounds(oneR,c) && !board[oneR*8+c]) {
                    targets.push([oneR,c]);
                    const twoR = r+2*dir;
                    if (r===startRow && !board[twoR*8+c]) targets.push([twoR,c]);
                }
                for (const dc of [-1,1]) {
                    const tr=r+dir, tc=c+dc;
                    if (inBounds(tr,tc)) {
                        const t = board[tr*8+tc];
                        if (t && t[0]!==color) {
                            targets.push([tr,tc]);
                        } else if (!t && enPassant && enPassant[0]===tr && enPassant[1]===tc) {
                            targets.push([tr,tc]);
                        }
                    }
                }
            } else if (ptype === 'N') {
                for (const [dr,dc] of KNIGHT_MOVES) {
                    const tr=r+dr, tc=c+dc;
                    if (inBounds(tr,tc)) {
                        const t = board[tr*8+tc];
                        if (!t || t[0]!==color) targets.push([tr,tc]);
                    }
                }
            } else if (ptype==='B' || ptype==='R' || ptype==='Q') {
                let dirs = [];
                if (ptype==='B'||ptype==='Q') dirs = dirs.concat(BISHOP_DIRS);
                if (ptype==='R'||ptype==='Q') dirs = dirs.concat(ROOK_DIRS);
                for (const [dr,dc] of dirs) {
                    let tr=r+dr, tc=c+dc;
                    while (inBounds(tr,tc)) {
                        const t = board[tr*8+tc];
                        if (!t) { targets.push([tr,tc]); }
                        else { if (t[0]!==color) targets.push([tr,tc]); break; }
                        tr+=dr;
                        tc+=dc;
                    }
                }
            } else if (ptype==='K') {
                for (const [dr,dc] of KING_DIRS) {
                    const tr=r+dr, tc=c+dc;
                    if (inBounds(tr,tc)) {
                        const t = board[tr*8+tc];
                        if (!t || t[0]!==color) targets.push([tr,tc]);
                    }
                }
                const homeRow = color==='w' ? 7 : 0;
                if (r===homeRow && c===4) {
                    const kFlag = color==='w' ? 'K' : 'k';
                    const qFlag = color==='w' ? 'Q' : 'q';
                    if (castling.includes(kFlag) && !board[homeRow*8+5] && !board[homeRow*8+6] && board[homeRow*8+7]===color+'R') {
                        targets.push([homeRow,6]);
                    }
                    if (castling.includes(qFlag) && !board[homeRow*8+3] && !board[homeRow*8+2] && !board[homeRow*8+1] && board[homeRow*8+0]===color+'R') {
                        targets.push([homeRow,2]);
                    }
                }
            }
            return targets;
        }

        function renderBoard(board, statusData) {
            const boardEl = document.getElementById('board');
            if (!boardEl) return;
            boardEl.innerHTML = '';
            for (let r = 0; r < 8; r++) {
                for (let c = 0; c < 8; c++) {
                    const idx = r*8+c;
                    const piece = board[idx];
                    const cell = document.createElement('div');
                    const isLight = (r+c) % 2 === 0;
                    cell.className = 'cell ' + (isLight ? 'light' : 'dark');
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    
                    if (piece) {
                        const pieceColor = piece[0];
                        const pieceType = piece[1];
                        const wrapper = document.createElement('div');
                        wrapper.className = 'piece-glyph';
                        wrapper.innerHTML = pieceMarkup(pieceType, pieceColor === 'w' ? 'piece-white' : 'piece-black');
                        cell.appendChild(wrapper);
                    }

                    if (statusData.in_check && piece === (statusData.in_check + 'K')) {
                        cell.classList.add('in-check');
                    }

                    if (selected && selected[0]===r && selected[1]===c) {
                        cell.classList.add('selected');
                    }
                    if (legalTargetsForSelected.some(([tr,tc]) => tr===r && tc===c)) {
                        cell.classList.add(piece ? 'hint-capture' : 'hint');
                    }

                    cell.addEventListener('click', () => onCellClick(r, c, board, statusData));
                    boardEl.appendChild(cell);
                }
            }
        }

        async function onCellClick(r, c, board, statusData) {
            const myTurn = statusData.status === 'playing' && myColor === statusData.turn;
            if (!myTurn) return;

            const piece = board[r*8+c];

            if (selected) {
                const isTarget = legalTargetsForSelected.some(([tr,tc]) => tr===r && tc===c);
                if (isTarget) {
                    const [fr, fc] = selected;
                    selected = null;
                    legalTargetsForSelected = [];
                    await makeMove(fr, fc, r, c);
                    return;
                }
                if (piece && piece[0] === myColor) {
                    selected = [r, c];
                    legalTargetsForSelected = pseudoTargets(board, r, c, statusData);
                    renderBoard(board, statusData);
                } else {
                    selected = null;
                    legalTargetsForSelected = [];
                    renderBoard(board, statusData);
                }
            } else {
                if (piece && piece[0] === myColor) {
                    selected = [r, c];
                    legalTargetsForSelected = pseudoTargets(board, r, c, statusData);
                    renderBoard(board, statusData);
                }
            }
        }

        async function makeMove(fr, fc, tr, tc) {
            try {
                const res = await fetch(`/chess/${roomCode}/move`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from_row: fr, from_col: fc, to_row: tr, to_col: tc })
                });
                const data = await res.json();
                const msgEl = document.getElementById('game-msg');
                if (data.success) {
                    msgEl.textContent = '';
                    msgEl.classList.remove('error');
                } else {
                    msgEl.textContent = data.error || '着手に失敗しました';
                    msgEl.classList.add('error');
                }
                fetchState();
            } catch (e) {
                console.error(e);
            }
        }

        function updatePlayersBox(data) {
            const box = document.getElementById('players-box');
            if (!box) return;
            const whiteYou = (myColor === 'w') ? ' (あなた)' : '';
            const blackYou = (myColor === 'b') ? ' (あなた)' : '';
            let html = `<div>⚪ ${escapeHtml(data.white_name)} <span style="opacity:0.7;">(ID:${data.white_id || '----'})</span>${whiteYou}</div>`;
            if (data.has_black) {
                html += `<div>⚫ ${escapeHtml(data.black_name)} <span style="opacity:0.7;">(ID:${data.black_id || '----'})</span>${blackYou}</div>`;
            } else {
                html += `<div style="opacity:0.6;">⚫ 対戦相手を待っています…</div>`;
            }
            box.innerHTML = html;
        }

        function updateStatusBar(data) {
            const indicator = document.getElementById('turn-indicator');
            const bannerArea = document.getElementById('result-banner-area');
            if (!indicator || !bannerArea) return;
            bannerArea.innerHTML = '';

            if (data.status === 'waiting') {
                indicator.textContent = '対戦相手を待っています…';
                indicator.style.color = 'var(--text-muted)';
            } else if (data.status === 'finished') {
                indicator.textContent = '対局終了';
                indicator.style.color = 'var(--text-muted)';
                const banner = document.createElement('div');
                banner.className = 'result-banner';
                if (data.winner === 'draw') {
                    banner.textContent = 'ステイルメイトで引き分けです';
                } else if (data.winner === myColor) {
                    banner.textContent = 'You win!!!!🎉（チェックメイト）';
                } else if (myColor) {
                    banner.textContent = 'You lose.......（チェックメイトされました）';
                } else {
                    banner.textContent = `${pieceLabel(data.winner)}の勝ちです（チェックメイト）`;
                }
                bannerArea.appendChild(banner);
                const backBtn = document.createElement('button');
                backBtn.textContent = '♟️ チェスロビーに戻る';
                backBtn.style.width = '100%';
                backBtn.style.marginBottom = '12px';
                backBtn.addEventListener('click', () => {
                    window.location.href = "/chess";
                });
                bannerArea.appendChild(backBtn);
            } else {
                let checkNote = data.in_check ? `（${pieceLabel(data.in_check)}がチェックされました！）` : '';
                if (!myColor) {
                    indicator.textContent = `観戦中（現在: ${pieceLabel(data.turn)}のターン）${checkNote}`;
                    indicator.style.color = 'var(--text-muted)';
                } else if (data.turn === myColor) {
                    indicator.textContent = `あなたのターンです${checkNote}`;
                    indicator.style.color = 'var(--accent-color)';
                } else {
                    indicator.textContent = `相手のターンです${checkNote}`;
                    indicator.style.color = 'var(--text-muted)';
                }
            }
        }

        async function fetchState() {
            try {
                const res = await fetch(`/api/chess/${roomCode}/state`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.my_color) myColor = data.my_color;

                let board = data.board;
                if (typeof board === 'string') {
                    try { board = JSON.parse(board); } catch(e) {}
                }

                updatePlayersBox(data);
                updateStatusBar(data);
                renderBoard(board, data);
            } catch (e) {
                console.error('状態取得エラー:', e);
            }
        }

        document.getElementById('copy-link-btn').addEventListener('click', () => {
            navigator.clipboard.writeText(window.location.href).then(() => {
                const btn = document.getElementById('copy-link-btn');
                const original = btn.textContent;
                btn.textContent = 'コピーしました';
                setTimeout(() => { btn.textContent = original; }, 1500);
            });
        });

        fetchState();

        let statePollBusy = false;
        async function pollGameState() {
            if (statePollBusy) return;
            statePollBusy = true;
            try { await fetchState(); } finally { statePollBusy = false; }
        }
        setInterval(pollGameState, 1500);
    </script>
    <% } %>
</body>
</html>
